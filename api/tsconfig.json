{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node16",
    "target": "ES2022",
    "esModuleInterop": true,
    "outDir": "dist",
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "strict": true
  }
}
